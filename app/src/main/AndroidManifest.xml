<?xml version="1.0" encoding="utf-8"?>
<!-- 影译 AndroidManifest -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 判断 Wi-Fi / 移动数据（模型下载的"仅 Wi-Fi"开关用），普通权限，安装时自动授予 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M5：WorkManager 长任务前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".AiVideoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AiVideo"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 从系统分享菜单接收视频文件：后续里程碑接入导入流程 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- M5：禁用 WorkManager 默认初始化，改由 AiVideoApp 手动注入 AiVideoWorkerFactory。
             血泪教训：不要用 @HiltWorker（Hilt 2.57.2 + KSP 下绑定代码不生成）。 -->
        <provider
            android:name="androidx.work.impl.WorkManagerInitializer"
            android:authorities="${applicationId}.workmanager-init"
            android:exported="false"
            tools:node="remove" />

        <!-- M5：WorkManager 的 SystemForegroundService 以 dataSync 类型 startForeground，
             manifest 里必须声明该类型，否则 API 31+ 系统线程直接抛异常闪退（try-catch 罩不住）。
             血泪教训：用 tools:node="merge" 把类型声明合并到 WorkManager 自带的 service 声明上。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- M5：成品视频分享/打开（FileProvider，只暴露 filesDir 下文件） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
